APP_ENV=development
APP_API_KEY=replace-with-a-long-local-token
ALLOW_SYNTHETIC_MODE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SQLITE_URL=data/app.db
CHROMA_DIR=data/chroma
DOCUMENT_DIR=data/documents
MAX_PDF_BYTES=52428800
MAX_PDF_PAGES=500
LEGACY_SYNC_MAX_PDF_BYTES=10485760
LEGACY_SYNC_MAX_PDF_PAGES=100
DEFAULT_CHAT_PROVIDER=deepseek
DEFAULT_CHAT_MODEL=deepseek-v4-pro
DEFAULT_EMBEDDING_PROVIDER=xfyun-spark
DEFAULT_EMBEDDING_MODEL=query
LOCAL_BGE_M3_BASE_URL=http://127.0.0.1:11434
LOCAL_BGE_M3_MODEL=bge-m3
XFYUN_SPARK_APP_ID=
XFYUN_SPARK_API_KEY=
XFYUN_SPARK_API_SECRET=
XFYUN_SPARK_EMBEDDING_URL=https://emb-cn-huabei-1.xf-yun.com
ENABLE_OPENALEX=false
OPENALEX_API_KEY=
OPENALEX_BASE_URL=https://api.openalex.org/works
ARXIV_BASE_URL=https://export.arxiv.org/api/query
ARXIV_USER_AGENT=CS-Gap-Assist/0.1 (literature-research-client)
ARXIV_MIN_INTERVAL_SECONDS=3
ARXIV_CACHE_TTL_SECONDS=300
RAG_MIN_SEMANTIC_SCORE=0.35
RAG_MIN_LEXICAL_SCORE=0.05
RAG_MAX_CONTEXT_TOKENS=6000
RAG_MAX_PROMPT_BYTES=100000
RAG_VECTOR_WEIGHT=0.55
RAG_LEXICAL_WEIGHT=0.45
RAG_RRF_K=60
RAG_MMR_LAMBDA=0.7
RAG_FINAL_TOP_K=8
ENABLE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
XFYUN_MAX_TEXT_BYTES=6000
XFYUN_EMBEDDING_CONCURRENCY=4
EXTERNAL_SEARCH_TIMEOUT_SECONDS=3
EXTERNAL_NETWORK_ENABLED=true
